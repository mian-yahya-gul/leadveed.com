# /etc/leadveed/leadveed.env  (created by setup.sh, chmod 600). Fill in the blanks.
NODE_ENV=production
PORT=4000
HOST=127.0.0.1

DATABASE_URL=postgresql://leadveed:__DB_PASSWORD__@127.0.0.1:5432/leadveed
TYPESENSE_URL=http://127.0.0.1:8108
TYPESENSE_API_KEY=__TYPESENSE_KEY__

# Shared secret with the Vercel app (LEADVEED_INTERNAL_KEY there). setup.sh generates it.
INTERNAL_API_KEY=__INTERNAL_KEY__
SITE_URL=https://leadveed.com

# Email (https://resend.com -> API keys). Used for removal confirmations.
RESEND_API_KEY=
EMAIL_FROM="LeadVeed <hello@leadveed.com>"

# Google PageSpeed Insights API key (Google Cloud console -> APIs -> PageSpeed Insights API -> Credentials)
PAGESPEED_API_KEY=
PAGESPEED_DAILY_BUDGET=20000

# Paddle (Developer tools -> Notifications -> destination's secret key).
# Plan price ids are built in; set PADDLE_PRICE_STARTER/PRO/AGENCY only to override them (e.g. sandbox).
PADDLE_WEBHOOK_SECRET=

# --- Data import ---
LEADVEED_DATA_DIR=/srv/leadveed/data
# Which countries to import (ISO codes, comma separated). Empty = the whole world (~60M places).
LEADVEED_COUNTRIES=
# Typesense keeps its index in RAM, and the whole world doesn't fit in 24 GB. These countries get
# instant, typo-tolerant search from Typesense; every other country is searched in Postgres,
# which holds the whole world. Empty = put everything in Typesense (only on a bigger server).
TYPESENSE_COUNTRIES=PK,AE,SA,QA,KW,BH,OM,GB,CA,AU,IN
LEADVEED_MIN_CONFIDENCE=0.3
DUCKDB_MEMORY_LIMIT=8GB

# --- Off-server backups (any S3-compatible bucket; Oracle Object Storage is Always Free) ---
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=ap-singapore-1
BACKUP_S3_KEY_ID=
BACKUP_S3_SECRET=
BACKUP_S3_BUCKET=leadveed-backups

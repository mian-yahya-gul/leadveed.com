# /etc/leadveed/leadveed.env  (created by setup.sh, chmod 600). Fill in the blanks.
NODE_ENV=production
PORT=4000
HOST=127.0.0.1

DATABASE_URL=postgresql://leadveed:__DB_PASSWORD__@127.0.0.1:5432/leadveed
TYPESENSE_URL=http://127.0.0.1:8108
TYPESENSE_API_KEY=__TYPESENSE_KEY__

# Shared secret with the Vercel app (LEADVEED_INTERNAL_KEY there). setup.sh generates it.
INTERNAL_API_KEY=__INTERNAL_KEY__
SITE_URL=https://leadveed.com

# Email (https://resend.com -> API keys). Used for removal confirmations.
RESEND_API_KEY=
EMAIL_FROM="LeadVeed <hello@leadveed.com>"

# Google PageSpeed Insights API key (Google Cloud console -> APIs -> PageSpeed Insights API -> Credentials)
PAGESPEED_API_KEY=
PAGESPEED_DAILY_BUDGET=20000

# Lemon Squeezy (Settings -> Webhooks signing secret; Products -> variant ids)
LEMONSQUEEZY_WEBHOOK_SECRET=
LS_VARIANT_STARTER=
LS_VARIANT_PRO=
LS_VARIANT_AGENCY=

# --- Data import ---
LEADVEED_DATA_DIR=/srv/leadveed/data
# Which countries to import (ISO codes, comma separated). Empty = whole world.
# The whole world is ~60M places: Postgres fits on the 200 GB disk, but Typesense keeps its
# index in RAM and needs more than this server's 24 GB. Start with your key markets:
LEADVEED_COUNTRIES=PK,AE,SA,QA,KW,BH,OM,GB,US,CA,AU,IN
LEADVEED_MIN_CONFIDENCE=0.3
DUCKDB_MEMORY_LIMIT=10GB

# --- Backups to Cloudflare R2 (S3 compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=leadveed-backups

[Unit]
Description=LeadVeed web app (Next.js)
After=network-online.target leadveed-api.service
Wants=network-online.target

[Service]
User=leadveed
WorkingDirectory=/srv/leadveed/app/apps/web
EnvironmentFile=/etc/leadveed/web.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /srv/leadveed/app/node_modules/next/dist/bin/next start -p 3000 -H 127.0.0.1
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target

[Unit]
Description=LeadVeed API
After=network-online.target postgresql.service typesense-server.service
Wants=network-online.target

[Service]
User=leadveed
WorkingDirectory=/srv/leadveed/app/apps/api
EnvironmentFile=/etc/leadveed/leadveed.env
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target

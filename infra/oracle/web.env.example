# /etc/leadveed/web.env  (created by setup.sh, chmod 600). Settings for the Next.js web app.
# After editing, rebuild and restart:  sudo /srv/leadveed/app/infra/oracle/deploy.sh

# The API runs on this same server, so the web app talks to it directly.
LEADVEED_API_URL=http://127.0.0.1:4000
# Same value as INTERNAL_API_KEY in leadveed.env. setup.sh fills it in.
LEADVEED_INTERNAL_KEY=__INTERNAL_KEY__
NEXT_PUBLIC_SITE_URL=https://leadveed.com

# Auth.js
AUTH_SECRET=__AUTH_SECRET__
AUTH_URL=https://leadveed.com
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM="LeadVeed <login@leadveed.com>"

# Lemon Squeezy hosted checkout links (Store -> Products -> Share)
LS_CHECKOUT_STARTER=
LS_CHECKOUT_PRO=
LS_CHECKOUT_AGENCY=
LS_CUSTOMER_PORTAL=

# --- LeadVeed web, for local development. On the server these live in /etc/leadveed/web.env ---
# Where the API runs (the Oracle server, behind Caddy)
LEADVEED_API_URL=https://api.leadveed.com
# Same value as INTERNAL_API_KEY on the server. Never expose to the browser.
LEADVEED_INTERNAL_KEY=change-me
NEXT_PUBLIC_SITE_URL=https://leadveed.com

# Auth.js  (generate AUTH_SECRET with: npx auth secret)
AUTH_SECRET=
AUTH_URL=https://leadveed.com
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=LeadVeed <login@leadveed.com>

# Paddle checkout (Paddle -> Developer tools -> Authentication -> client-side token; it's public)
PADDLE_CLIENT_TOKEN=
# "sandbox" to test against sandbox-vendors.paddle.com (then also set PADDLE_PRICE_STARTER/PRO/AGENCY)
PADDLE_ENV=production
# Paddle -> Checkout -> Checkout settings -> customer portal link
PADDLE_CUSTOMER_PORTAL=
